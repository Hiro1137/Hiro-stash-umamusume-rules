name: Mihomo 分流规则转换版
desc: 保留原有策略组、Sukka 广告拦截和远程规则集；完整替换原策略组与路由规则。
# 使用 Stash 覆写语法；需搭配包含代理节点的主配置文件。
# 注意：规则列表使用 #!replace，会替换订阅原有的路由规则。

proxy-groups: #!replace
  # 默认代理组，直接拉取所有节点
  - name: "🚀 默认代理"
    type: select
    include-all: true
    proxies:
      - "DIRECT"

  # 各项服务分类组，默认跟随“🚀 默认代理”，但你可以随时在面板里点开，直接选中任何一个底层节点
  - name: "📹 YouTube"
    type: select
    include-all: true
    proxies:
      - "🚀 默认代理"
      - "DIRECT"

  - name: "🍀 Google"
    type: select
    include-all: true
    proxies:
      - "🚀 默认代理"
      - "DIRECT"

  - name: "🤖 AI"
    type: select
    include-all: true
    proxies:
      - "🚀 默认代理"
      - "DIRECT"

  - name: "👨🏿‍💻 GitHub"
    type: select
    include-all: true
    proxies:
      - "🚀 默认代理"
      - "DIRECT"

  - name: "🐬 OneDrive"
    type: select
    include-all: true
    proxies:
      - "🚀 默认代理"
      - "DIRECT"

  - name: "🪟 Microsoft"
    type: select
    include-all: true
    proxies:
      - "🚀 默认代理"
      - "DIRECT"

  - name: "🎵 TikTok"
    type: select
    include-all: true
    proxies:
      - "🚀 默认代理"
      - "DIRECT"

  - name: "📱 Telegram"
    type: select
    include-all: true
    proxies:
      - "🚀 默认代理"
      - "DIRECT"

  - name: "🎥 NETFLIX"
    type: select
    include-all: true
    proxies:
      - "🚀 默认代理"
      - "DIRECT"

  - name: "✨ Disney"
    type: select
    include-all: true
    proxies:
      - "🚀 默认代理"
      - "DIRECT"

  - name: "📺 HBO"
    type: select
    include-all: true
    proxies:
      - "🚀 默认代理"
      - "DIRECT"

  - name: "🎧 Spotify"
    type: select
    include-all: true
    proxies:
      - "🚀 默认代理"
      - "DIRECT"

  - name: "💵 PayPal"
    type: select
    include-all: true
    proxies:
      - "🚀 默认代理"
      - "DIRECT"

  - name: "🌍 国外网站"
    type: select
    include-all: true
    proxies:
      - "🚀 默认代理"
      - "DIRECT"

  - name: "🐟 漏网之鱼"
    type: select
    include-all: true
    proxies:
      - "🚀 默认代理"
      - "DIRECT"

rule-providers:
  reject_non_ip_no_drop:
    behavior: classical
    format: text
    interval: 43200
    url: https://ruleset.skk.moe/Clash/non_ip/reject-no-drop.txt
    path: ./sukkaw_ruleset/reject_non_ip_no_drop.txt
  reject_non_ip_drop:
    behavior: classical
    format: text
    interval: 43200
    url: https://ruleset.skk.moe/Clash/non_ip/reject-drop.txt
    path: ./sukkaw_ruleset/reject_non_ip_drop.txt
  reject_non_ip:
    behavior: classical
    format: text
    interval: 43200
    url: https://ruleset.skk.moe/Clash/non_ip/reject.txt
