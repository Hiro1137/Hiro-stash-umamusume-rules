rules!:
  # 广告与隐私拦截规则
  - RULE-SET,reject_non_ip_drop,REJECT-DROP
  - RULE-SET,reject_domainset,REJECT
  - RULE-SET,reject_extra_domainset,REJECT
  - RULE-SET,reject_non_ip,REJECT
  - RULE-SET,reject_non_ip_no_drop,REJECT

  # 原有直连规则
  - DOMAIN-SUFFIX,download.nvidia.com,DIRECT
  - DOMAIN-SUFFIX,update.playstation.net,DIRECT
  - DOMAIN-SUFFIX,prod.dl.playstation.net,DIRECT
  - GEOSITE,steam@cn,DIRECT
  - DOMAIN-SUFFIX,steamserver.net,DIRECT

  # ====================================
  # 新增：WebRTC 防护规则
  # ====================================

  # Zoom / Discord 域名优先处理
  # 避免这些域名命中后续通用拦截规则
  - DOMAIN-SUFFIX,zoom.us,DIRECT
  - DOMAIN-SUFFIX,zoom.com,DIRECT
  - DOMAIN-SUFFIX,discord.com,🚀 默认代理
  - DOMAIN-SUFFIX,discord.gg,🚀 默认代理

  # 常见 STUN / TURN 端口
  - DST-PORT,3478,🛡️ WebRTC防护
  - DST-PORT,5349,🛡️ WebRTC防护

  # Google STUN 常见端口范围
  - DST-PORT,19302,🛡️ WebRTC防护
  - DST-PORT,19303,🛡️ WebRTC防护
  - DST-PORT,19304,🛡️ WebRTC防护
  - DST-PORT,19305,🛡️ WebRTC防护
  - DST-PORT,19306,🛡️ WebRTC防护
  - DST-PORT,19307,🛡️ WebRTC防护
  - DST-PORT,19308,🛡️ WebRTC防护
  - DST-PORT,19309,🛡️ WebRTC防护

  # STUN 域名拦截
  - DOMAIN-KEYWORD,stun,🛡️ WebRTC防护

  # ====================================
  # 以下保留原有分流规则
  # ====================================

  - DOMAIN-SUFFIX,xn--ngstr-lra8j.com,🍀 Google
  - DOMAIN-SUFFIX,googleapis.cn,🍀 Google
  - DOMAIN-SUFFIX,googleapis.com,🍀 Google
  - "RULE-SET,private_ip,DIRECT,no-resolve"
  - "RULE-SET,private_domain,DIRECT"
  - "DOMAIN-SUFFIX,yycloud.org,🚀 默认代理"
  - "DOMAIN-SUFFIX,yyg.ink,🚀 默认代理"
  - "RULE-SET,proxylite,🚀 默认代理"

  # AI 服务
  - "RULE-SET,ai,🤖 AI"
  - "RULE-SET,ChatGPT_Domain,🤖 AI"
  - "RULE-SET,Claude_Domain,🤖 AI"
  - "RULE-SET,Meta_AI_Domain,🤖 AI"
  - "RULE-SET,Perplexity_Domain,🤖 AI"
  - "RULE-SET,Copilot_Domain,🪟 Microsoft"
  - "RULE-SET,Gemini_Domain,🤖 AI"

  # 各平台与服务
  - "RULE-SET,github_domain,👨🏿‍💻 GitHub"
  - "RULE-SET,youtube_domain,📹 YouTube"
  - "RULE-SET,Disney_Domain,✨ Disney"
  - "RULE-SET,HBO_Domain,📺 HBO"
  - "RULE-SET,Spotify_Domain,🎧 Spotify"
  - "RULE-SET,google_domain,🍀 Google"
  - "RULE-SET,onedrive_domain,🐬 OneDrive"
  - "RULE-SET,microsoft_domain,🪟 Microsoft"
  - "RULE-SET,apple_domain,DIRECT"
  - "RULE-SET,tiktok_domain,🎵 TikTok"
  - "RULE-SET,telegram_domain,📱 Telegram"
  - "RULE-SET,netflix_domain,🎥 NETFLIX"
  - "RULE-SET,paypal_domain,💵 PayPal"

  # IP 分流
  - "RULE-SET,apple_ip,DIRECT"
  - "RULE-SET,google_ip,🍀 Google"
  - "RULE-SET,netflix_ip,🎥 NETFLIX"
  - "RULE-SET,telegram_ip,📱 Telegram"

  # 全球与中国规则
  - "RULE-SET,Globe_Domain,🌍 国外网站"
